rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.role in ['admin', 'superadmin']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.role == 'superadmin') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isFullAdmin() {
      return isAdmin();
    }

    function isApprovedDriver() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApprovedDriver == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        );
    }

    function rideLocked() {
      // Immutable ride fields after creation
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['userId','priceFcfa','distanceKm','durationMin','pickupAddress','destinationAddress',
                 'pickupLat','pickupLng','destinationLat','destinationLng','serviceType','createdAt']);
    }

    function nextOk(a, b) {
      return (a == 'confirmed' && b == 'driver_arriving')
          || (a == 'driver_arriving' && b == 'driver_arrived')
          || (a == 'driver_arrived' && b == 'in_progress')
          || (a == 'in_progress' && b == 'completed');
    }

    // Test Connection for boot health check
    match /test/{testId} {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isSuperAdmin();
    }

    // Admin Activity Logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Driver Codes Reservation (e.g. GNG-XXXXXX)
    match /driverCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.driverId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // System Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Public Drivers Directory (for map or client visibility)
    match /publicDrivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == driverId || isAdmin());
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Driver or Client Registration
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role in ['client', 'driver_pending'] &&
        (!('isApprovedDriver' in request.resource.data) || request.resource.data.isApprovedDriver == false) &&
        (!('approved' in request.resource.data) || request.resource.data.approved == false) &&
        request.resource.data.get('applicationStatus', 'pending') == 'pending'
      );

      // Updates strictly prevent modifying RBAC and approval fields by regular user
      allow update: if isFullAdmin() || (
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'isApprovedDriver',
          'approved',
          'ratingAverage',
          'ratingCount',
          'totalRatingSum',
          'applicationStatus',
          'rejectionReason',
          'suspensionReason',
          'reviewedBy',
          'reviewedAt',
          'adminNote',
          'checklist',
          'driverCode',
          'cardType',
          'cardNumber',
          'cardValidFrom',
          'cardValidUntil'
        ]) &&
        // Driver cannot go online unless approved by admin
        (
          request.resource.data.get('isOnline', false) == false || 
          resource.data.get('isApprovedDriver', false) == true ||
          resource.data.get('approved', false) == true
        )
      );

      allow delete: if isAdmin();
    }

    // Rides Collection
    match /rides/{rideId} {
      // Reading allowed for admin, ride owner, assigned driver, or approved driver (if pending)
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.status == 'pending' && isApprovedDriver())
      );

      // Client creates a pending ride with price bounds and length check
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('driverId', null) == null &&
        request.resource.data.priceFcfa is number &&
        request.resource.data.priceFcfa > 0 &&
        request.resource.data.priceFcfa <= 100000 &&
        request.resource.data.pickupAddress.size() <= 200;

      allow update: if isAdmin()
        // 1. Client cancels before ride starts
        || (
          resource.data.userId == request.auth.uid && 
          rideLocked() &&
          request.resource.data.status == 'cancelled' &&
          resource.data.status in ['pending', 'confirmed', 'driver_arriving', 'driver_arrived']
        )
        // 2. Client rates completed ride
        || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'completed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingComment', 'ratedAt', 'updatedAt'])
        )
        // 3. Approved driver accepts pending ride
        || (
          isApprovedDriver() && 
          rideLocked() && 
          resource.data.status == 'pending' &&
          resource.data.get('driverId', null) in [null, ''] &&
          request.resource.data.status == 'confirmed' &&
          request.resource.data.driverId == request.auth.uid
        )
        // 4. Approved driver ignores pending ride (adds self to declinedBy)
        || (
          isApprovedDriver() && 
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declinedBy', 'updatedAt']) &&
          request.auth.uid in request.resource.data.declinedBy
        )
        // 5. Assigned driver updates ride status, cancels or records payment
        || (
          resource.data.driverId == request.auth.uid && (
            // Progression along lifecycle
            (rideLocked() && nextOk(resource.data.status, request.resource.data.status))
            // Driver cancellation during in_progress
            || (rideLocked() && resource.data.status == 'in_progress' && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == 'driver')
            // Driver cancellation before in_progress: resets back to pending
            || (rideLocked() && resource.data.status in ['confirmed', 'driver_arriving', 'driver_arrived'] && request.resource.data.status == 'pending' && request.resource.data.driverId == null)
            // Payment receipt update after completion
            || (resource.data.status == 'completed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentMethod', 'updatedAt']))
          )
        );

      allow delete: if isAdmin();
    }
  }
}
